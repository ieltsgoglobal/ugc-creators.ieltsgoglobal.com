generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String @id @default(cuid())
  googleSub String @unique
  email     String
  name      String
  creatorProfile CreatorProfile?
  assignedInstagramAccount InstagramAccount?
  creatorWallet CreatorWallet?
  creatorReferral CreatorReferral?
  walletTransactions CreatorWalletTransaction[]
  withdrawalRequests CreatorWithdrawalRequest[]
}

model CreatorProfile {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  user                  User?    @relation(fields: [userId], references: [id])
  email                 String   @unique
  fullName              String
  whatsapp              String
  country               String
  age                   Boolean
  instagramUsername     String
  instagramUrl          String
  followers             Int?
  platforms             String?
  niche                 String?
  promotionalExperience Boolean?
  language              String?
  audienceCountry       String?
  onCamera              Boolean?
  weeklyVideos          Int?
  promotionAccount      Boolean?
  terms                 Boolean
  payout                Boolean
  disclosure            Boolean
  submittedAt           DateTime @default(now())
  approvedAt            DateTime?

  @@map("creator_application")
}

model InstagramAccount {
  id                 String  @id @default(cuid())
  username           String  @unique
  password           String
  assignedToUserId   String? @unique
  assignedToUser     User?   @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
}

enum CreatorWalletTransactionKind {
  CREDIT
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
}

enum CreatorWithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

model CreatorWithdrawalRequest {
  id           String                     @id @default(cuid())
  userId       String
  user         User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestKey   String
  amountPaise  Int
  status       CreatorWithdrawalStatus    @default(PENDING)
  payoutMethod CreatorPayoutMethod?
  payoutDestination String?
  createdAt    DateTime                   @default(now())
  transactions CreatorWalletTransaction[]

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@map("creator_withdrawal_requests")
}

model CreatorWalletTransaction {
  id                  String                       @id @default(cuid())
  userId              String
  user                User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawalRequestId String?
  withdrawalRequest   CreatorWithdrawalRequest?    @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)
  kind                CreatorWalletTransactionKind
  amountPaise         Int
  createdAt           DateTime                     @default(now())

  @@unique([withdrawalRequestId, kind])
  @@index([userId, createdAt])
  @@map("creator_wallet_transactions")
}

enum CreatorPayoutMethod {
  UPI
  PAYPAL
}

model CreatorWallet {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutMethod CreatorPayoutMethod
  payoutDestination String
  updatedAt DateTime @updatedAt

  @@map("creator_wallets")
}

model CreatorReferral {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  url       String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("creator_referrals")
}

model Subscription {
  id                String          @id @default(cuid())

  creatorReferralId String
  creatorReferral   CreatorReferral @relation(fields: [creatorReferralId], references: [id], onDelete: Restrict)

  externalReference String          @unique
  subscribedAt      DateTime
  createdAt         DateTime        @default(now())

  @@index([creatorReferralId, subscribedAt])
  @@map("subscriptions")
}
