generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String @id @default(cuid())
  googleSub String @unique
  email     String
  name      String
  creatorProfile CreatorProfile?
  assignedInstagramAccount InstagramAccount?
  walletTransactions CreatorWalletTransaction[]
  withdrawalRequests CreatorWithdrawalRequest[]
}

model CreatorProfile {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  user                  User?    @relation(fields: [userId], references: [id])
  email                 String   @unique
  fullName              String
  whatsapp              String
  country               String
  age                   Boolean
  instagramUsername     String
  instagramUrl          String
  followers             Int?
  platforms             String?
  niche                 String?
  promotionalExperience Boolean?
  language              String?
  audienceCountry       String?
  onCamera              Boolean?
  weeklyVideos          Int?
  promotionAccount      Boolean?
  terms                 Boolean
  payout                Boolean
  disclosure            Boolean
  submittedAt           DateTime @default(now())
  approvedAt            DateTime?

  @@map("creator_application")
}

model InstagramAccount {
  id                 String  @id @default(cuid())
  username           String  @unique
  password           String
  assignedToUserId   String? @unique
  assignedToUser     User?   @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
}

enum CreatorWalletTransactionKind {
  CREDIT
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
}

enum CreatorWithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

model CreatorWithdrawalRequest {
  id           String                     @id @default(cuid())
  userId       String
  user         User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestKey   String
  amountPaise  Int
  status       CreatorWithdrawalStatus    @default(PENDING)
  createdAt    DateTime                   @default(now())
  transactions CreatorWalletTransaction[]

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@map("creator_withdrawal_requests")
}

model CreatorWalletTransaction {
  id                  String                       @id @default(cuid())
  userId              String
  user                User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawalRequestId String?
  withdrawalRequest   CreatorWithdrawalRequest?    @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)
  kind                CreatorWalletTransactionKind
  amountPaise         Int
  createdAt           DateTime                     @default(now())

  @@unique([withdrawalRequestId, kind])
  @@index([userId, createdAt])
  @@map("creator_wallet_transactions")
}
